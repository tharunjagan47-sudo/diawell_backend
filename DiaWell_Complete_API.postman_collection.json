{
  "info": {
    "name": "DiaWell - Complete App Backend APIs",
    "description": "Complete collection of REST APIs for DiaWell Android App, covering Auth, Profile, Glucose, Diet, Medications, Activity, Home Dashboard, Reports, Notifications, AI Assistant, and Settings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/DiaWell_backend",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "8",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Sign Up",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mary Jane\",\n  \"email\": \"mary.jane@example.com\",\n  \"password\": \"Password123@\",\n  \"confirm_password\": \"Password123@\"\n}"
            },
            "url": "{{base_url}}/auth/signup.php"
          }
        },
        {
          "name": "1.2 Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mary.jane@example.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": "{{base_url}}/auth/login.php"
          }
        },
        {
          "name": "1.3 Forgot / Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mary.jane@example.com\",\n  \"new_password\": \"NewPassword123@\",\n  \"confirm_new_password\": \"NewPassword123@\"\n}"
            },
            "url": "{{base_url}}/auth/forgotpassword.php"
          }
        }
      ]
    },
    {
      "name": "2. Profile & Preferences",
      "item": [
        {
          "name": "2.1 Save Patient Details (Step 1)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"diabetes_type\": \"Type 2\",\n  \"age\": 30,\n  \"height_cm\": 165,\n  \"weight_kg\": 68,\n  \"current_glucose_mg_dl\": 128,\n  \"target_glucose_mg_dl\": 120\n}"
            },
            "url": "{{base_url}}/auth/patientdetails.php"
          }
        },
        {
          "name": "2.2 Get Patient Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/patientdetails.php?user_id={{user_id}}"
          }
        },
        {
          "name": "2.3 Save Health Preferences (Step 2)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"health_focus\": \"Glucose Control\",\n  \"dietary_preferences\": [\"Non-Vegetarian\", \"Low-Carb / Keto\"],\n  \"allergies\": [\"Nuts\"],\n  \"activity_level\": \"Moderate (3-5 days/week)\"\n}"
            },
            "url": "{{base_url}}/auth/healthpreferences.php"
          }
        },
        {
          "name": "2.4 Get Health Preferences",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/healthpreferences.php?user_id={{user_id}}"
          }
        },
        {
          "name": "2.5 Save Food Preferences Settings",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"preferred_diet\": \"Non-Vegetarian\",\n  \"allergies\": [\"Nuts\", \"Milk\"],\n  \"preferred_styles\": [\"Whole grains\", \"Vegetables\", \"Fish\", \"Poultry\"],\n  \"foods_to_avoid\": \"Excess sugary sodas\"\n}"
            },
            "url": "{{base_url}}/auth/foodpreferences.php"
          }
        },
        {
          "name": "2.6 Get Food Preferences",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/foodpreferences.php?user_id={{user_id}}"
          }
        },
        {
          "name": "2.7 Edit Personal Profile",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"full_name\": \"Mary Jane Watson\",\n  \"email\": \"mary.jane@example.com\",\n  \"diabetes_type\": \"Type 2\",\n  \"age\": 30,\n  \"height_cm\": 165,\n  \"weight_kg\": 68\n}"
            },
            "url": "{{base_url}}/auth/editprofile.php"
          }
        },
        {
          "name": "2.8 Upload Profile Photo",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "user_id", "value": "{{user_id}}", "type": "text"},
                {"key": "profile_photo", "type": "file"}
              ]
            },
            "url": "{{base_url}}/auth/uploadprofile.php"
          }
        },
        {
          "name": "2.9 Get Full Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/uploadprofile.php?user_id={{user_id}}"
          }
        }
      ]
    },
    {
      "name": "3. Glucose Tracking",
      "item": [
        {
          "name": "3.1 Log Glucose Reading",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"reading_value\": 128,\n  \"reading_type\": \"Fasting\",\n  \"reading_date\": \"2026-10-15\",\n  \"reading_time\": \"07:30:00\",\n  \"notes\": \"Before breakfast, after overnight fast.\"\n}"
            },
            "url": "{{base_url}}/glucose/log.php"
          }
        },
        {
          "name": "3.2 Glucose History & Chart",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/glucose/history.php?user_id={{user_id}}&range=7 days"
          }
        },
        {
          "name": "3.3 Glucose Reading Details & Trend",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/glucose/details.php?user_id={{user_id}}"
          }
        },
        {
          "name": "3.4 Delete Glucose Reading",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/glucose/details.php?user_id={{user_id}}&reading_id=1"
          }
        }
      ]
    },
    {
      "name": "4. Diet & Nutrition",
      "item": [
        {
          "name": "4.1 Log Meal",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"meal_category\": \"BREAKFAST\",\n  \"food_name\": \"Berry & almond oats\",\n  \"portion\": \"1 bowl • 290 g\",\n  \"calories\": 320,\n  \"carbs_g\": 42.0,\n  \"protein_g\": 12.0,\n  \"fat_g\": 9.0,\n  \"log_date\": \"2026-10-15\",\n  \"log_time\": \"08:30:00\",\n  \"icon\": \"🥣\"\n}"
            },
            "url": "{{base_url}}/diet/log.php"
          }
        },
        {
          "name": "4.2 Get Daily Food Log",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/diet/log.php?user_id={{user_id}}&date=2026-10-15"
          }
        },
        {
          "name": "4.3 Explore / Search Foods",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/diet/explore.php?user_id={{user_id}}&query=oats&category=All"
          }
        },
        {
          "name": "4.4 Food Nutritional Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/diet/details.php?category=Breakfast"
          }
        },
        {
          "name": "4.5 Daily Nutrition Summary",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/diet/summary.php?user_id={{user_id}}&date=2026-10-15"
          }
        },
        {
          "name": "4.6 Delete Logged Meal",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/diet/log.php?user_id={{user_id}}&log_id=1"
          }
        }
      ]
    },
    {
      "name": "5. Medications",
      "item": [
        {
          "name": "5.1 Get Medications List",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/meds/list.php?user_id={{user_id}}&date=2026-10-15"
          }
        },
        {
          "name": "5.2 Add Medication Reminder",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"name\": \"Metformin\",\n  \"dose\": \"500 mg • 1 Tablet\",\n  \"reminder_time\": \"20:00:00\",\n  \"reminder_date\": \"2026-10-15\",\n  \"timing\": \"After Meal\",\n  \"frequency\": \"Daily\",\n  \"notes\": \"Take with a glass of water after dinner.\"\n}"
            },
            "url": "{{base_url}}/meds/add.php"
          }
        },
        {
          "name": "5.3 Update Medication Status (Taken/Missed)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"medication_id\": 1,\n  \"status\": \"Taken\"\n}"
            },
            "url": "{{base_url}}/meds/update_status.php"
          }
        },
        {
          "name": "5.4 Search Medication Catalog",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/meds/search.php?query=metformin"
          }
        },
        {
          "name": "5.5 Delete Medication",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"medication_id\": 1\n}"
            },
            "url": "{{base_url}}/meds/delete.php"
          }
        }
      ]
    },
    {
      "name": "6. Activity Tracking",
      "item": [
        {
          "name": "6.1 Log Workout Activity",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"activity_type\": \"Walking\",\n  \"duration_mins\": 33,\n  \"distance_km\": 2.8,\n  \"calories_kcal\": 185,\n  \"glucose_before\": 128,\n  \"glucose_after\": 106,\n  \"activity_date\": \"2026-10-15\",\n  \"activity_time\": \"07:45:00\",\n  \"notes\": \"Morning brisk walk.\"\n}"
            },
            "url": "{{base_url}}/activity/log.php"
          }
        },
        {
          "name": "6.2 Activity History & Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity/history.php?user_id={{user_id}}&filter=All"
          }
        },
        {
          "name": "6.3 Activity Targets & Recommendations",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity/recommendations.php?user_id={{user_id}}"
          }
        }
      ]
    },
    {
      "name": "7. Home Dashboard",
      "item": [
        {
          "name": "7.1 Get Home Dashboard Metrics",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/home/dashboard.php?user_id={{user_id}}"
          }
        }
      ]
    },
    {
      "name": "8. Reports",
      "item": [
        {
          "name": "8.1 Get Weekly Health Report",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reports/weekly.php?user_id={{user_id}}&end_date=2026-10-15"
          }
        }
      ]
    },
    {
      "name": "9. Notifications",
      "item": [
        {
          "name": "9.1 Get Notifications List",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications/list.php?user_id={{user_id}}"
          }
        },
        {
          "name": "9.2 Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"notification_id\": 1\n}"
            },
            "url": "{{base_url}}/notifications/mark_read.php"
          }
        },
        {
          "name": "9.3 Clear All Notifications",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}}\n}"
            },
            "url": "{{base_url}}/notifications/clear_all.php"
          }
        }
      ]
    },
    {
      "name": "10. JARVIS AI Chatbot",
      "item": [
        {
          "name": "10.1 Send Message to AI",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"message\": \"What can I eat for breakfast?\"\n}"
            },
            "url": "{{base_url}}/ai/chat.php"
          }
        },
        {
          "name": "10.2 Get Chat History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ai/chat.php?user_id={{user_id}}"
          }
        },
        {
          "name": "10.3 Clear Chat History",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/ai/chat.php?user_id={{user_id}}"
          }
        }
      ]
    },
    {
      "name": "11. Settings & Account",
      "item": [
        {
          "name": "11.1 Change Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"current_password\": \"Password123@\",\n  \"new_password\": \"NewPassword123@\",\n  \"confirm_password\": \"NewPassword123@\"\n}"
            },
            "url": "{{base_url}}/settings/change_password.php"
          }
        },
        {
          "name": "11.2 Get Notification Preferences",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/settings/notification_preferences.php?user_id={{user_id}}"
          }
        },
        {
          "name": "11.3 Update Notification Preferences",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"medication_reminders\": true,\n  \"meal_logging_reminders\": true,\n  \"glucose_checkins\": true,\n  \"weekly_report_alerts\": true\n}"
            },
            "url": "{{base_url}}/settings/notification_preferences.php"
          }
        },
        {
          "name": "11.4 Export Health Records (JSON)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/settings/export_records.php?user_id={{user_id}}&format=json&range=all"
          }
        },
        {
          "name": "11.5 Delete Account",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"password\": \"NewPassword123@\"\n}"
            },
            "url": "{{base_url}}/settings/delete_account.php"
          }
        }
      ]
    }
  ]
}

